<%= form_with model: child, class: "grid gap-4" do |f| %>
  <%= render "shared/form_errors", record: child %>
  <label class="grid gap-1.5"><span class="label">Name</span><%= f.text_field :name, class: "field", required: true, autofocus: true %></label>
  <label class="grid gap-1.5"><span class="label">Birth date (optional)</span><%= f.date_field :birth_date, class: "field" %></label>
  <%= f.submit "Save", class: "btn btn-primary" %>
<% end %>
