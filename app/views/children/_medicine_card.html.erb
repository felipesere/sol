<% medicine = status.medicine %>
<% style = medicine_style(child, medicine) %>
<% tone, label = dose_state_pill(status) %>
<article class="card p-4 grid gap-3">
  <div class="flex items-start justify-between gap-2">
    <div>
      <h3 class="font-display text-[19px] font-bold flex items-center gap-2">
        <span class="mark <%= style[:mark] %>" style="--c: var(<%= style[:color] %>)"></span><%= medicine.name %>
      </h3>
      <p class="text-mute text-[13px] mt-0.5"><%= number(medicine.dose_amount) %> <%= medicine.dose_unit %> · every <%= duration(medicine.min_interval_minutes) %> · max <%= medicine.max_doses_per_24h %> per 24 h</p>
    </div>
    <span class="pill <%= tone %>"><%= label %></span>
  </div>
  <div class="grid gap-1.5">
    <div class="pips" style="--c: var(<%= style[:color] %>)">
      <% medicine.max_doses_per_24h.times do |i| %><span class="pip<%= " on" if i < status.count %>"></span><% end %>
    </div>
    <p class="text-[13px] text-mute"><span class="text-ink font-semibold"><%= status.count %> of <%= medicine.max_doses_per_24h %></span> doses in the last 24 h</p>
  </div>
  <% if status.ok? %>
    <p class="text-[14px]"><%= status.last_dose ? "Last dose #{ago(status.last_dose.given_at)} by #{status.last_dose.user.first_name}" : "No doses in the last 24 h" %></p>
  <% else %>
    <p class="text-[14px]">Next dose at <strong><%= clock(status.next_allowed_at) %></strong> (in <%= duration((status.next_allowed_at - Time.current) / 60) %>)</p>
    <p class="text-mute text-[13px] -mt-2">Last dose <%= ago(status.last_dose.given_at) %> by <%= status.last_dose.user.first_name %></p>
  <% end %>
  <%= link_to (status.ok? ? "Give #{number(medicine.dose_amount)} #{medicine.dose_unit}" : "Give anyway"),
        new_child_dose_path(child, medicine_id: medicine.id),
        class: "btn btn-sm #{status.ok? ? "btn-primary" : "btn-ghost"} w-full" %>
</article>
