<div class="mx-auto max-w-sm grid gap-4 pt-10">
  <h1 class="text-3xl font-bold">Who is this?</h1>
  <% if alert %><p class="text-red-600"><%= alert %></p><% end %>

  <% if auth_config.household? %>
    <% auth_config.household_names.each do |name| %>
      <%= button_to name, session_path, params: { name: name }, class: "w-full rounded-xl border px-4 py-4 text-lg font-semibold" %>
    <% end %>
  <% else %>
    <%= button_to "Sign in", "/auth/oidc", data: { turbo: false }, class: "w-full rounded-xl border px-4 py-4 text-lg font-semibold" %>
  <% end %>
</div>
