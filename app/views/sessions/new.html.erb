<% content_for :title, "Sol" %>
<div class="grid gap-4 pt-6">
  <h1 class="font-display text-[30px] font-bold">Who is this?</h1>
  <% if auth_config.household? %>
    <% auth_config.household_names.each do |name| %>
      <%= button_to name, session_path, params: { name: name }, class: "btn btn-ghost", form: { class: "contents" }, style: "min-height: 56px; font-size: 18px" %>
    <% end %>
  <% else %>
    <%= button_to "Sign in", "/auth/oidc", data: { turbo: false }, class: "btn btn-primary", form: { class: "contents" }, style: "min-height: 56px; font-size: 18px" %>
  <% end %>
</div>
