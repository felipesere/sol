<% content_for :title, "Edit dose · Sol" %>
<div class="flex items-center justify-between"><h1 class="font-display text-[26px] font-bold">Edit dose</h1><%= link_to "Cancel", child_path(@child), class: "btn btn-ghost btn-sm" %></div>
<p class="text-mute -mt-3">Logged by <%= @dose.user.name %></p>
<%= render "form", dose: @dose %>
<%= button_to "Delete this dose", child_dose_path(@child, @dose), method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Delete this dose?" } } %>
